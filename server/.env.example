NODE_ENV=development
PORT=8000
API_VERSION=/api/v1
BACKEND_URL=http://localhost:8000
CORS_ORIGIN=http://localhost:3000

# MySQL  (mysql://USER:PASSWORD@HOST:PORT/DATABASE)
DATABASE_URL=mysql://root:password@localhost:3306/therentalz

# JWT — generate each with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_VERIFICATION_SECRET=
JWT_PASSWORD_RESET_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_VERIFICATION_EXPIRES_IN=30m
JWT_PASSWORD_RESET_EXPIRES_IN=15m
TOKEN_MAX_AGE=15m
REFRESH_TOKEN_MAX_AGE=7d
SALT_ROUNDS=12

# Email (SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=TheRentalz
EMAIL_FROM_ADDRESS=comm@therentalz.com

# Cloudflare R2 (image uploads, S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudflare Turnstile (captcha on register/login)
TURNSTILE_SECRET_KEY=

# Seed admin (used by npm run seed:admin)
ADMIN_EMAIL=admin@therentalz.com
ADMIN_PASSWORD=

# Shared secret for on-demand cache refresh of the frontend (same value as the client)
REVALIDATE_SECRET=

# Sign in with Google / Facebook. The API sends people back to <BACKEND_URL><API_VERSION>/auth/<provider>/callback,
# so add that address to the OAuth client (Google console: Authorised redirect URIs; Facebook: Valid OAuth Redirect URIs).
# Set OAUTH_REDIRECT_BASE only if the API is reached at a different public address (for example behind a proxy).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# OAUTH_REDIRECT_BASE=https://api.example.com/api/v1/auth
